<?xml version="1.0" encoding="utf-8"?>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="#102B46"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URBANFLOW"
                android:textColor="#45D6B0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Meus trajetos"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Seus caminhos, sempre acompanhados."
                android:textColor="#D5E2ED"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Conteúdo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Cartão de cadastro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOVO TRAJETO"
                    android:textColor="#167D72"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Para onde você vai?"
                    android:textColor="#102B46"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- Origem -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="PONTO DE PARTIDA"
                    android:textColor="#627D98"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtOrigem"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="Ex.: Minha casa"
                    android:padding="15dp"
                    android:singleLine="true"
                    android:textColor="#102B46"
                    android:textColorHint="#8A9BAA"
                    android:drawableStart="@android:drawable/ic_menu_mylocation"
                    android:drawablePadding="12dp"
                    android:inputType="textCapSentences" />

                <!-- Destino -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="DESTINO"
                    android:textColor="#627D98"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtDestino"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="Ex.: Universidade"
                    android:padding="15dp"
                    android:singleLine="true"
                    android:textColor="#102B46"
                    android:textColorHint="#8A9BAA"
                    android:drawableStart="@android:drawable/ic_menu_directions"
                    android:drawablePadding="12dp"
                    android:inputType="textCapSentences" />

                <!-- Botão -->
                <Button
                    android:id="@+id/btnSalvarTrajeto"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="26dp"
                    android:backgroundTint="#167D72"
                    android:text="＋  Salvar meu trajeto"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

            </LinearLayout>

            <!-- Lista -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seus trajetos"
                    android:textColor="#102B46"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Caminhos que você salvou no UrbanFlow."
                    android:textColor="#627D98"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/listaTrajetos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- Rodapé -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="URBANFLOW • ARAÇATUBA - SP"
                android:textColor="#8A9BAA"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>


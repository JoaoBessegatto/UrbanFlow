<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnVoltarPerfil"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:tint="#102B46"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meu Perfil"
            android:textColor="#102B46"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <ImageView
            android:id="@+id/imgFotoPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:background="#DCE8ED"
            android:padding="20dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces"
            android:contentDescription="Foto do perfil" />

        <Button
            android:id="@+id/btnAlterarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="Adicionar foto"
            android:textColor="#FFFFFF"
            android:backgroundTint="#167D72" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do usuário"
            android:textColor="#102B46"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="28dp" />

        <EditText
            android:id="@+id/edtNomePerfil"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_login_input"
            android:hint="Digite seu nome"
            android:padding="14dp"
            android:textColor="#102B46"
            android:textColorHint="#7A8995"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnSalvarPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Salvar perfil"
            android:textColor="#FFFFFF"
            android:backgroundTint="#102B46" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_card"
            android:padding="20dp"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Minha participação"
                android:textColor="#102B46"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPontosPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 pontos"
                android:textColor="#167D72"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sua contribuição ajuda a melhorar Araçatuba!"
                android:textColor="#526575"
                android:textSize="14sp"
                android:layout_marginTop="5dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DCE4E9"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No UrbanFlow desde"
                android:textColor="#526575"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtDataInicioPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--/--/----"
                android:textColor="#102B46"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSairConta"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#B3261E"
            android:text="Sair da conta"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UrbanFlow — A cidade melhora quando todos participam."
            android:textColor="#7A8995"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
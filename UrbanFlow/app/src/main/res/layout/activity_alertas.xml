<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABEÇALHO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="210dp"
            android:background="#102B46"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:contentDescription="Voltar" />

            <ImageView
                android:layout_width="170dp"
                android:layout_height="95dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Logo UrbanFlow"
                android:src="@drawable/logo_urbanflow_mobilidade_inteligente"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Central de alertas"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Fique informado sobre o trânsito da cidade."
                android:textColor="#D5E2ED"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- CONTEÚDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- DESTAQUE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E0F5EF"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●  MONITORAMENTO URBANO"
                    android:textColor="#167D72"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sua cidade em atenção."
                    android:textColor="#102B46"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Consulte os avisos e acompanhe informações importantes para seus deslocamentos."
                    android:textColor="#486581"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- LISTA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Seus avisos"
                android:textColor="#102B46"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Informações organizadas por categoria."
                android:textColor="#627D98"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/listaAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <!-- RODAPÉ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="URBANFLOW • ARAÇATUBA - SP"
                android:textColor="#8A9BAA"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

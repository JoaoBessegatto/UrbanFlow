<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">


        <!-- CABEÇALHO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#102B46"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <ImageButton
                android:id="@+id/btnPerfil"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:contentDescription="Abrir meu perfil"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#FFFFFF" />

            <ImageView
                android:layout_width="190dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Logo UrbanFlow"
                android:src="@drawable/logo_urbanflow_mobilidade_inteligente"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Olá, Seja bem-vindo!"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Sua mobilidade começa aqui."
                android:textColor="#C5D7E5"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#1D4564"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp"
                android:text="⌖  ARAÇATUBA • SP"
                android:textColor="#45D6B0"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CONTEÚDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- BOTÃO DE LEITURA POR VOZ -->
            <Button
                android:id="@+id/btnOuvirPagina"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#167D72"
                android:text="🔊 Ouvir leitura da página"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- STATUS DO TRÂNSITO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="SITUAÇÃO DO TRÂNSITO"
                    android:textColor="#627D98"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStatusTransito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aguardando dados..."
                    android:textColor="#102B46"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Monitoramento inteligente das vias"
                    android:textColor="#829AB1"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="18dp"
                    android:background="#45D6B0" />

            </LinearLayout>

            <!-- TÍTULO DOS MÓDULOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Explore o UrbanFlow"
                android:textColor="#102B46"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tudo o que você precisa para se movimentar melhor."
                android:textColor="#829AB1"
                android:textSize="13sp" />

            <!-- MAPA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#E2F7F1"
                    android:gravity="center"
                    android:text="⌖"
                    android:textColor="#167D72"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mapa inteligente"
                        android:textColor="#102B46"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Explore o trânsito da cidade"
                        android:textColor="#829AB1"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnMapa"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="#167D72"
                    android:minWidth="0dp"
                    android:text="Abrir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- TRAJETOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#EAF1FB"
                    android:gravity="center"
                    android:text="➜"
                    android:textColor="#2864A0"
                    android:textSize="27sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meus trajetos"
                        android:textColor="#102B46"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Salve seus caminhos favoritos"
                        android:textColor="#829AB1"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnTrajetos"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="#2864A0"
                    android:minWidth="0dp"
                    android:text="Abrir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- OCORRÊNCIAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#FFF1E5"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="#D97732"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ocorrências"
                        android:textColor="#102B46"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Compartilhe problemas nas vias"
                        android:textColor="#829AB1"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOcorrencias"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="#D97732"
                    android:minWidth="0dp"
                    android:text="Abrir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ALERTAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#F0EBFA"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#7954B5"
                    android:textSize="23sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minhas notificações"
                        android:textColor="#102B46"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Acompanhe seus alertas"
                        android:textColor="#829AB1"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAlertas"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="#7954B5"
                    android:minWidth="0dp"
                    android:text="Abrir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ACESSIBILIDADE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashboard_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#E2F7F1"
                    android:gravity="center"
                    android:text="♿"
                    android:textColor="#167D72"
                    android:textSize="27sp"
                    android:contentDescription="Acessibilidade" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acessibilidade"
                        android:textColor="#102B46"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Personalize sua experiência"
                        android:textColor="#829AB1"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAcessibilidade"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="#167D72"
                    android:minWidth="0dp"
                    android:text="Abrir"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- RODAPÉ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="UrbanFlow • Mobilidade inteligente"
                android:textColor="#829AB1"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mapa Inteligente"
            android:textColor="#123B65"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Monitoramento do trânsito em Araçatuba - SP"
            android:textColor="#60758A"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="22dp"
            android:background="#DCE7F0"
            android:gravity="center"
            android:padding="20dp"
            android:text="MAPA DE ARAÇATUBA\n\nÁrea de visualização do trânsito"
            android:textColor="#123B65"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Legenda do trânsito"
            android:textColor="#123B65"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🟢 Trânsito livre"
            android:textColor="#263746"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🟡 Trânsito moderado"
            android:textColor="#263746"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🔴 Trânsito intenso"
            android:textColor="#263746"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Condições das vias"
            android:textColor="#123B65"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDadosMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Aguardando informações de trânsito..."
            android:textColor="#60758A"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:text="Voltar ao início"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
